<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arka_plan">
    <LinearLayout
        android:id="@+id/resimGrubu"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:orientation="horizontal"
        android:padding="10dp"
        android:background="@color/kart_rengi"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/kayitGrubu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="12dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/fotograf1"
            android:scaleType="centerCrop"
            android:contentDescription="@string/ilkbahar" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:src="@drawable/fotograf2"
            android:scaleType="centerCrop"
            android:contentDescription="@string/yaz" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:src="@drawable/fotograf3"
            android:scaleType="centerCrop"
            android:contentDescription="@string/sonbahar" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:src="@drawable/fotograf4"
            android:scaleType="centerCrop"
            android:contentDescription="@string/kis" />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/kayitGrubu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/kart_rengi"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/resimGrubu"
        app:layout_constraintBottom_toTopOf="@id/girisGrubu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/adSoyad"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/ad_soyad"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/eposta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/eposta"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/yas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/yas"
            android:inputType="number" />

        <Button
            android:id="@+id/kayitButonu"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="@string/kayit_ol"
            android:textColor="@color/white"
            android:backgroundTint="@color/kayit_buton" />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/girisGrubu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_margin="12dp"
        android:background="@color/kart_rengi"
        app:layout_constraintTop_toBottomOf="@id/kayitGrubu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/kullaniciAdi"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/kullanici_adi"
            android:inputType="text" />

        <EditText
            android:id="@+id/sifre"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/sifre"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/girisButonu"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="@string/giris_yap"
            android:textColor="@color/white"
            android:backgroundTint="@color/giris_buton" />

        <TextView
            android:id="@+id/sifremiUnuttum"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/sifremi_unuttum"
            android:textColor="@color/link_rengi"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>



